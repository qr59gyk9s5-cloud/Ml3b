# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

NODE_ENV=development

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Supabase (real project not created yet — see docs/operations/deployment.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Points at a real Supabase project's Postgres connection string once one
# exists. For local schema/migration work against a plain local Postgres
# instead (no Supabase project needed), see docs/operations/local-development.md.
DATABASE_URL=postgres://app_user:app_password@localhost:5432/sports_marketplace

# Used only by `pnpm test:integration` (src/testing/db.ts) — a disposable
# database that gets dropped and rebuilt on every run. Never point this at
# anything you care about.
TEST_DATABASE_URL=postgres://app_user:app_password@localhost:5432/sports_marketplace_test

# --- Background jobs (Phase 8) ---
# Authenticates Vercel Cron's calls into src/app/api/cron/* — set this in
# Vercel's own project env vars too (Settings -> Environment Variables),
# it must match exactly. See docs/architecture/background-jobs.md.
CRON_SECRET=

# --- Email (Phase 9) ---
# No account connected yet — leave both blank and src/lib/notifications
# logs instead of sending. See docs/architecture/notifications.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
